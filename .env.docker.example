# Used by `docker compose --env-file .env.docker up` (see docker-compose.yml)
# to expose the app to OTHER machines, not just the Docker host itself.
#
# Copy this to .env.docker and replace <host> with an address other
# people's browsers can actually reach:
#   - same LAN:      your machine's LAN IP, e.g. 192.168.1.23
#   - public internet: your public IP or domain, with the port forwarded
#                       through your router/firewall to this host
# Do NOT use "localhost" here — that resolves to each visitor's own
# machine, not yours.
#
# vxcubed-be (the backend, run separately — see its own docker-compose.yml)
# must also have its FRONTEND_URL env var set to match wherever this
# frontend ends up reachable (e.g. http://<host>:5173), or CORS will
# reject requests from other people's browsers.

VITE_API_URL="http://<host>:4002"

# vx-learn-3d-dev — points at vxcubed-be-dev's HTTPS front door (Caddyfile.dev,
# port 4443), not its plain-HTTP port directly. Response encryption needs
# crypto.subtle, which browsers only expose on a secure context (https, or
# localhost) — plain http://<host>:5174 doesn't qualify, so LAN access must go
# through https://<host>:5443 instead. See Caddyfile.dev.
VITE_API_URL_DEV="https://<host>:4443"

# Must exactly match vxcubed-be-dev's RESPONSE_ENCRYPTION_KEY env var — the
# app-level response encryption feature is dev-only for now.
VITE_RESPONSE_ENCRYPTION_KEY_DEV="<same value as vxcubed-be-dev's RESPONSE_ENCRYPTION_KEY>"
